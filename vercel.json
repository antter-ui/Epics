{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/server.js": {
      "includeFiles": "{data/healthcare.db,public/firebase-config.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server?__apiPath=$1"
    }
  ]
}
